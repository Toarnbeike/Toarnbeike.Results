   public static Result<{{ target_type }}> {{ method_name }}{{ type_parameters }}(
        this {{ target_type }} value{{ if parameter_list != "" }}, {{ parameter_list }}{{ end }},
        string? message = null,
        [CallerArgumentExpression(nameof(value))] string? expr = null)
        {{~ for constraint in constraints ~}} 
        {{ constraint }} 
        {{~ end ~}}
    {
        return Result.Ensure()
            .That(value).{{ method_name }}({{ argument_list }})
            .WithCustomExpression(expr).WithCustomMessage(message)
            .ToResult();
    }